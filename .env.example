# ==============================================================================
# NUTM Learn Backend - Environment Configuration Template
# All production secrets must be securely provided via enterprise key vaults.
# ==============================================================================

# Database Configuration (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/nutm_lms?schema=public"
DATABASE_TEST_URL="postgresql://user:password@localhost:5432/nutm_lms_test?schema=public"

# Application Environment
NODE_ENV="development"
PORT="3000"
APP_BASE_URL="http://localhost:3000"

# Application Security & Sessions
# Must be at least 32 characters of cryptographically secure random string
SESSION_SECRET="replace-with-a-cryptographically-secure-32-char-random-key"
SESSION_MAX_AGE_SECONDS="28800" # 8 hours

# Microsoft Entra ID (OIDC / MSAL) Integration
# Mandatory for institutional single sign-on
ENTRA_TENANT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_ID="00000000-0000-0000-0000-000000000000"
ENTRA_CLIENT_SECRET="replace-with-approved-azure-ad-app-client-secret"
ENTRA_REDIRECT_URI="http://localhost:3000/api/v1/auth/callback"
# Graph API Scopes (narrowly scoped: openid, profile, email, User.Read)
ENTRA_SCOPES="openid,profile,email,User.Read"

# One-time IT Administrator Bootstrap Secret
# Protects the seed script or administrative initialization endpoint
ADMIN_BOOTSTRAP_SECRET="replace-with-high-entropy-bootstrap-secret"

# Storage Provider Configuration
# Options: "local" (for development / test offline sandbox) or "sharepoint" (production Microsoft Graph)
STORAGE_PROVIDER="local"
LOCAL_STORAGE_DIR="./storage"

# Microsoft SharePoint / Graph Storage Settings (required if STORAGE_PROVIDER=sharepoint)
SHAREPOINT_SITE_ID=""
SHAREPOINT_DRIVE_ID=""
SHAREPOINT_ROOT_FOLDER="NUTM-Learn-Materials"

# Logging & Monitoring
LOG_LEVEL="info"
